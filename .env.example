# Copy to .env and fill in real keys. `.env` is gitignored; this file is safe to
# commit. Values are read by settings seeding (packages/server/src/settings.ts),
# by the Makefile (exported to host runs and docker compose) and by index.ts
# (process.loadEnvFile) for direct dev starts.
#
# Default model provider: "ekreke-copy" (power.acme.red) → deepseek-v4.1-flash.
HPATH_ROUTER_API_KEY=
# Fallback provider: "ekreke" (llm.ekreke.cn).
EKREKE_API_KEY=
